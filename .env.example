FUB_API_KEY=
# FUB system identity (X-System header) and shared key (X-System-Key header
# on outbound API calls; same value verifies inbound FUB-Signature webhooks).
FUB_X_SYSTEM=MKTNG-Agent-Systems
FUB_X_SYSTEM_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your personal Telegram chat ID for operator alerts. Not Ben's.
OPERATOR_TELEGRAM_CHAT_ID=
# Optional. A real FUB contact ID used to verify API connectivity at startup.
HEALTH_CHECK_CONTACT_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
GOOGLE_CALENDAR_CREDENTIALS_PATH=clients/ben-olsen/secrets/google_calendar_credentials.json
# Tenant client identifier (e.g. ben-olsen). Used by watchdog alert labels.
CLIENT_ID=ben-olsen
# Cloud CMA Phase 1
CLOUDCMA_API_KEY=
CLOUDCMA_WIDGET_URL=https://cloudcma.com/cmas/widget
CMA_REDIRECT_BASE=https://webhook.brightworkrealty.com
CMA_PDF_ARCHIVE_DIR=
